# Choose either OpenAI, Gemini, or provide both.
# The app automatically detects available keys!

# OpenAI API Key (for GPT-4o)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (for Gemini 2.5 Flash / 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: explicitly set preferred provider ("openai" or "gemini")
# DEFAULT_AI_PROVIDER=auto

# ─── Authentication Settings ──────────────────────────────────────────
# JWT Secret Key for token signature (Recommended to change for production)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-32chars
JWT_EXPIRE_DAYS=7

# ─── Supabase Cloud Database (PostgreSQL) ───────────────────────────
# Obtain from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Optional: SQLite Database Path (offline fallback when Supabase is omitted)
# DB_PATH=./kanban_users.db

# Optional: Gradio basic auth for kanban_voice.py
# GRADIO_AUTH_USER=admin
# GRADIO_AUTH_PASSWORD=your_secure_password
