# Choose either OpenAI, Gemini, or provide both.
# The app automatically detects available keys!

# OpenAI API Key (for GPT-4o)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (for Gemini 2.5 Flash / 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: explicitly set preferred provider ("openai" or "gemini")
# DEFAULT_AI_PROVIDER=auto
